<div id="graveScan"
    class="scan-grave-root"
    data-scan-url="{{scanUrl}}"
    data-confirm-url="{{confirmUrl}}"
    data-login-url="{{loginUrl}}">
    <p class="scan-kicker">{{synagogue.name}}</p>
    <h1 class="scan-title">Надгробие</h1>
    <p class="public-intro scan-lead">Сфотографируйте плиту. Имя и дата подставятся в карточку — проверьте их и сохраните.</p>

    <img id="scanPreview" class="scan-preview" alt="Фото надгробия" hidden>

    <section id="scanCapture" class="scan-actions">
        <label class="public-button public-button-primary scan-capture-btn">
            Сфотографировать
            <input class="scan-file" type="file" accept="image/*" capture="environment" data-scan-input>
        </label>
        <label class="public-button public-button-secondary scan-capture-btn">
            Из галереи
            <input class="scan-file" type="file" accept="image/*" data-scan-input>
        </label>
        <p class="scan-foot">Для сотрудников общины</p>
    </section>

    <section id="scanLoading" class="scan-loading" hidden>
        <div class="public-submit-overlay-spinner scan-spinner" aria-hidden="true"></div>
        <p>Читаем надпись…</p>
    </section>

    <section id="scanReview" hidden>
        <form id="scanForm" class="public-form scan-form">
            <p id="scanAlert" class="public-error scan-alert" hidden></p>
            <p id="scanConfidence" class="scan-confidence" hidden></p>

            <label class="public-field">
                <span>Имя</span>
                <input name="name" id="scanName" maxlength="120" required autocomplete="off" placeholder="Фамилия и имя">
            </label>
            <label class="public-field">
                <span>Отчество или имя отца</span>
                <input name="fatherNameOrPatronymic" id="scanFather" maxlength="120" autocomplete="off">
            </label>
            <div class="public-date-grid scan-date">
                <label class="public-field">
                    <span>День</span>
                    <input name="date" id="scanDay" inputmode="numeric" min="1" max="31" required>
                </label>
                <label class="public-field">
                    <span>Месяц</span>
                    <input name="month" id="scanMonth" inputmode="numeric" min="1" max="12" required>
                </label>
                <label class="public-field">
                    <span>Год</span>
                    <input name="year" id="scanYear" inputmode="numeric" min="1800" max="2100" required>
                </label>
            </div>
            <label class="public-field">
                <span>Еврейская дата</span>
                <input name="hebrewDateText" id="scanHebrew" maxlength="200" autocomplete="off">
            </label>
            <label class="public-field">
                <span>Эпитафия</span>
                <textarea dir="auto" name="epitaphOrBio" id="scanEpitaph" maxlength="2000"></textarea>
            </label>

            <div id="scanMatches" class="scan-matches" hidden></div>

            <details id="scanRawWrap" hidden>
                <summary>Текст с плиты</summary>
                <pre id="scanRaw"></pre>
            </details>

            <div class="public-actions">
                <button type="submit" class="public-button public-button-primary" id="scanSubmit">Сохранить на доску</button>
                <button type="button" class="public-button public-button-secondary" id="scanRetake">Снять заново</button>
            </div>
        </form>
    </section>

    <section id="scanDone" class="scan-done" hidden>
        <h2 class="public-section-title">Сохранено</h2>
        <p id="scanDoneName" class="public-name"></p>
        <div class="public-actions">
            <button type="button" class="public-button public-button-primary" id="scanAgain">Сканировать ещё</button>
            <a class="public-button public-button-secondary" href="{{peopleUrl}}">К списку людей</a>
        </div>
    </section>
</div>
<noscript>
    <p class="public-note">Для сканирования нужен JavaScript.</p>
</noscript>
