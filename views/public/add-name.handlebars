<section class="public-card">
    <div class="public-lang-switch public-lang-switch-pills public-lang-switch-top" role="navigation" aria-label="{{publicT 'language_label'}}">
        <a href="{{formUrl}}?lang=he" class="public-lang-pill{{#if (eq lang 'he')}} is-active{{/if}}" aria-current="{{#if (eq lang 'he')}}true{{else}}false{{/if}}">עברית</a>
        <a href="{{formUrl}}?lang=ru" class="public-lang-pill{{#if (eq lang 'ru')}} is-active{{/if}}" aria-current="{{#if (eq lang 'ru')}}true{{else}}false{{/if}}">Русский</a>
        <a href="{{formUrl}}?lang=en" class="public-lang-pill{{#if (eq lang 'en')}} is-active{{/if}}" aria-current="{{#if (eq lang 'en')}}true{{else}}false{{/if}}">English</a>
    </div>

    <div class="public-brand">
        <img class="public-brand-logo" src="{{officialLogoUrl}}" alt="">
        {{#if communityLogoUrl}}
        <span class="public-community-logo-wrap is-logo-plain{{#if (eq communityLogoBackground 'white')}} logo-bg-white{{/if}}{{#if (eq communityLogoBackground 'black')}} logo-bg-black{{/if}}">
            <img class="public-community-logo" src="{{communityLogoUrl}}" alt="{{synagogue.name}}">
        </span>
        {{/if}}
    </div>

    <h1>{{publicT 'page_title'}}</h1>
    {{#if errorMessage}}
    <p class="public-error" role="alert">{{errorMessage}}</p>
    {{/if}}

    <form method="POST" action="{{formUrl}}" class="public-form" id="publicAddNameForm"
        data-deceased-badge-prefix="{{deceasedBadgePrefix}}"
        data-deceased-count-unit="{{deceasedCountUnit}}"
        data-submit-single="{{publicT 'submit'}}">
        <input type="hidden" name="lang" value="{{lang}}">
        <div class="public-honeypot" aria-hidden="true">
            <label>
                <span>Website</span>
                <input type="text" name="{{honeypotField}}" tabindex="-1" autocomplete="off">
            </label>
        </div>

        <div class="public-deceased-block public-contact-block">
            <h2 class="public-deceased-block-title">{{publicT 'contact_section_title'}}</h2>
            <label class="public-field">
                <span>{{publicT 'contact_name_label'}}</span>
                <input type="text" name="contactName" maxlength="120" required value="{{values.contactName}}" placeholder="{{publicT 'contact_name_placeholder'}}">
            </label>
            <div class="public-phone-row">
                <label class="public-field public-field-phone-dial">
                    <span>{{publicT 'contact_phone_label'}}</span>
                    <select name="contactPhoneDial" class="public-select-field public-phone-dial" dir="ltr" required>
                        {{#each phoneDialOptions}}
                        <option value="{{this.dial}}" {{#if (eq ../values.contactPhoneDial this.dial)}}selected{{/if}}>{{this.label}} {{this.country}}</option>
                        {{/each}}
                    </select>
                </label>
                <label class="public-field public-field-phone-national">
                    <span class="public-visually-hidden">{{publicT 'contact_phone_label'}}</span>
                    <input type="tel" name="contactPhoneNational" class="public-phone-national" maxlength="20" required value="{{values.contactPhoneNational}}" placeholder="{{phonePlaceholder}}" dir="ltr" inputmode="tel" autocomplete="tel-national">
                    <input type="hidden" name="contactPhone" value="{{values.contactPhone}}">
                </label>
            </div>
        </div>

        <div id="publicDeceasedList" class="public-deceased-list">
            {{#each deceasedList}}
            {{> public-add-name-deceased-block index=this.index block=this inviteMode=false relationOptions=../relationOptions monthOptions=../monthOptions}}
            {{/each}}
        </div>

        <p class="public-add-deceased-wrap">
            <button type="button" class="public-button public-button-secondary public-add-deceased-btn" id="publicAddDeceasedBtn">
                <span class="public-add-deceased-icon" aria-hidden="true">+</span>
                <span class="public-add-deceased-label">{{publicT 'add_another_deceased'}}</span>
            </button>
        </p>

        <label class="public-field public-field-notes">
            <span>{{publicT 'deceased_notes_label'}}</span>
            <textarea name="deceasedNotes" rows="3" maxlength="2000" placeholder="{{publicT 'deceased_notes_placeholder'}}">{{values.deceasedNotes}}</textarea>
        </label>

        <div class="public-field public-field-consent">
            <label class="public-consent-label">
                <input type="checkbox" name="dataConsent" value="1" class="public-choice-checkbox" required>
                <span class="public-consent-text">{{publicT 'consent_label'}}</span>
            </label>
        </div>

        <div class="public-actions">
            <button type="submit" class="public-button public-button-primary" id="publicSubmitBtn">
                <span class="public-submit-label">{{submitButtonLabel}}</span>
                <span class="public-submit-spinner" hidden aria-hidden="true"></span>
            </button>
        </div>

    </form>

    <template id="publicDeceasedTemplate">
        {{> public-add-name-deceased-block index="0" block=emptyDeceasedTemplateBlock inviteMode=false relationOptions=relationOptions monthOptions=monthOptions}}
    </template>

    <div class="public-submit-overlay" id="publicSubmitOverlay" hidden aria-hidden="true">
        <div class="public-submit-overlay-card" role="status" aria-live="polite">
            <div class="public-submit-overlay-spinner" aria-hidden="true"></div>
            <p class="public-submit-overlay-text">{{publicT 'submitting'}}</p>
        </div>
    </div>
</section>

<script src="/js/public-add-name-death-date.js"></script>
<script src="/js/public-add-name-deceased.js"></script>
<script src="/js/public-add-name-phone.js"></script>
<script>
(function () {
  var form = document.querySelector('.public-form');
  var overlay = document.getElementById('publicSubmitOverlay');
  var submitBtn = document.getElementById('publicSubmitBtn');
  if (!form || !overlay || !submitBtn) {
    return;
  }

  var submitted = false;
  form.addEventListener('submit', function () {
    if (submitted) {
      return;
    }
    submitted = true;
    overlay.hidden = false;
    overlay.setAttribute('aria-hidden', 'false');
    submitBtn.disabled = true;
    submitBtn.setAttribute('aria-busy', 'true');
    var spinner = submitBtn.querySelector('.public-submit-spinner');
    if (spinner) {
      spinner.hidden = false;
    }
  });
})();
</script>
