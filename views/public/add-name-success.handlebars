<section class="public-card public-card-success">
    <h1>{{publicT 'request_success_title'}}</h1>

    {{#if isMultiRequest}}
    <p class="public-intro">{{publicT 'request_success_multi'}}</p>
    {{else}}
    <p class="public-intro">{{publicT 'request_success_message'}}</p>
    {{/if}}

    {{#if submittedNames.length}}
    <div class="public-success-summary">
        <h2 class="public-section-title">{{publicT 'success_summary_title'}}</h2>
        <ul class="public-success-names">
            {{#each submittedNames}}
            <li>{{this}}</li>
            {{/each}}
        </ul>
    </div>
    {{else}}
    {{#if submittedName}}
    <p class="public-name">{{submittedName}}</p>
    {{/if}}
    {{/if}}

    <div class="public-charity-section">
        <h2 class="public-charity-title">{{publicT 'charity_title'}}</h2>
        <p class="public-intro">{{publicT 'charity_message'}}</p>
        <div class="public-actions">
            {{#if publicSubmission.donationUrl}}
            <a href="{{publicSubmission.donationUrl}}" class="public-button public-button-primary" target="_blank" rel="noopener noreferrer">{{publicT 'charity_button'}}</a>
            {{else}}
            <p class="public-note">{{publicT 'charity_unavailable'}}</p>
            {{/if}}
        </div>
    </div>

    <div class="public-actions public-success-actions">
        <button type="button" class="public-share-icon-btn" id="publicShareLinkBtn" data-share-url="{{shareUrl}}" data-share-label="{{publicT 'success_share_link'}}" data-copied-label="{{publicT 'success_link_copied'}}" aria-label="{{publicT 'success_share_aria'}}">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92"/></svg>
        </button>
    </div>
</section>

<script>
(function () {
  var btn = document.getElementById('publicShareLinkBtn');
  if (!btn) {
    return;
  }
  var url = btn.getAttribute('data-share-url') || '';
  var shareLabel = btn.getAttribute('data-share-label') || 'Share';
  var copiedLabel = btn.getAttribute('data-copied-label') || 'Copied';

  btn.addEventListener('click', async function () {
    if (!url) {
      return;
    }
    if (navigator.share) {
      try {
        await navigator.share({ url, title: document.title });
        return;
      } catch (err) {
        /* fall through to copy */
      }
    }
    try {
      await navigator.clipboard.writeText(url);
      btn.setAttribute('aria-label', copiedLabel);
      window.setTimeout(function () {
        btn.setAttribute('aria-label', shareLabel);
      }, 2000);
    } catch (err) {
      window.prompt(shareLabel, url);
    }
  });
})();
</script>
