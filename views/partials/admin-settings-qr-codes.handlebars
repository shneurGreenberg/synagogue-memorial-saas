        {{#if showPublicLinkRegion}}
        <article class="settings-media-tile settings-control-tile">
            <fieldset class="public-link-region-fieldset">
                <legend class="settings-control-tile-title">{{t 'public_link_region_label'}}</legend>
                <label class="public-link-region-option">
                    <input type="radio" name="publicLinkRegion" value="auto" {{#unless (or (eq synagogue.publicLinkRegion 'ru') (eq synagogue.publicLinkRegion 'intl'))}}checked{{/unless}}>
                    <span>{{t 'public_link_region_auto'}}</span>
                </label>
                <label class="public-link-region-option">
                    <input type="radio" name="publicLinkRegion" value="ru" {{#if (eq synagogue.publicLinkRegion 'ru')}}checked{{/if}}>
                    <span>{{t 'public_link_region_ru'}}</span>
                </label>
                <label class="public-link-region-option">
                    <input type="radio" name="publicLinkRegion" value="intl" {{#if (eq synagogue.publicLinkRegion 'intl')}}checked{{/if}}>
                    <span>{{t 'public_link_region_intl'}}</span>
                </label>
            </fieldset>
            <div class="form-field settings-media-field">
                <label for="resolvedPublicBoardUrl">{{t 'public_link_region_resolved'}}</label>
                <input type="text" class="form-control admin-input-modern" id="resolvedPublicBoardUrl" readonly value="{{resolvedPublicBoardUrl}}">
            </div>
            <button type="button" class="btn-admin btn-admin-secondary btn-admin-sm" id="publicLinkCopyBtn" data-copy-label="{{t 'public_link_copy'}}" data-copied-label="{{t 'public_link_copied'}}">{{t 'public_link_copy'}}</button>
            <script>
                (function () {
                    var button = document.getElementById('publicLinkCopyBtn');
                    var input = document.getElementById('resolvedPublicBoardUrl');
                    if (!button || !input) return;
                    button.addEventListener('click', function () {
                        var text = input.value || '';
                        var label = button.getAttribute('data-copy-label') || button.textContent;
                        var copied = button.getAttribute('data-copied-label') || label;
                        function done() {
                            button.textContent = copied;
                            window.setTimeout(function () { button.textContent = label; }, 1600);
                        }
                        if (navigator.clipboard && navigator.clipboard.writeText) {
                            navigator.clipboard.writeText(text).then(done).catch(function () {
                                input.focus();
                                input.select();
                            });
                            return;
                        }
                        input.focus();
                        input.select();
                    });
                })();
            </script>
        </article>
        {{/if}}
        <article class="settings-media-tile">
            <div class="admin-theme-setting settings-qr-visibility-toggle">
                <div class="admin-theme-setting-label">{{t 'show_donation_qr_on_board'}}</div>
                <div class="admin-theme-setting-control">
                    <label class="toggle-switch" for="publicSubmissionShowDonationQr">
                        <input type="hidden" name="publicSubmissionShowDonationQr" value="0">
                        <input type="checkbox" id="publicSubmissionShowDonationQr" name="publicSubmissionShowDonationQr" value="1" {{#if synagogue.publicSubmission.showDonationQr}}checked{{/if}}>
                        <span class="toggle-slider" aria-hidden="true"></span>
                    </label>
                </div>
            </div>
            <div class="saved-view-thumb settings-media-thumb settings-media-thumb--square">
                {{#if synagogue.publicSubmission.donationQrImage}}
                <img src="/images/{{synagogue.publicSubmission.donationQrImage}}" alt="{{t 'donation_qr_alt'}}">
                {{else}}
                <img src="/images/donation-qr.svg" alt="{{t 'donation_qr_alt'}}">
                {{/if}}
                <span class="saved-view-thumb-label settings-media-thumb-label">{{t 'donation_qr_upload_title'}}</span>
            </div>
            <label class="file-drop-label file-drop-label-compact settings-media-action">
                {{t 'replace_qr_image'}}
                <input type="file" name="donationQrImage" accept="image/*">
            </label>
            <div class="form-field settings-media-field">
                <label for="publicSubmissionDonationUrl">{{t 'public_submission_donation_url'}}</label>
                <input type="url" class="form-control admin-input-modern" id="publicSubmissionDonationUrl" name="publicSubmissionDonationUrl" value="{{synagogue.publicSubmission.donationUrl}}" placeholder="https://">
            </div>
        </article>
        <article class="settings-media-tile">
            <div class="admin-theme-setting settings-qr-visibility-toggle">
                <div class="admin-theme-setting-label">{{t 'show_registration_qr_on_board'}}</div>
                <div class="admin-theme-setting-control">
                    <label class="toggle-switch" for="publicSubmissionShowRegistrationQr">
                        <input type="hidden" name="publicSubmissionShowRegistrationQr" value="0">
                        <input type="checkbox" id="publicSubmissionShowRegistrationQr" name="publicSubmissionShowRegistrationQr" value="1" {{#if synagogue.publicSubmission.showRegistrationQr}}checked{{/if}}>
                        <span class="toggle-slider" aria-hidden="true"></span>
                    </label>
                </div>
            </div>
            <div class="saved-view-thumb settings-media-thumb settings-media-thumb--square">
                {{#if synagogue.publicSubmission.registrationQrImage}}
                <img src="/images/{{synagogue.publicSubmission.registrationQrImage}}" alt="{{t 'memorial_submission_qr_alt'}}">
                {{else}}
                <img src="/images/memorial-submission-qr.svg" alt="{{t 'memorial_submission_qr_alt'}}">
                {{/if}}
                <span class="saved-view-thumb-label settings-media-thumb-label">{{t 'registration_qr_upload_title'}}</span>
            </div>
            <label class="file-drop-label file-drop-label-compact settings-media-action">
                {{t 'replace_qr_image'}}
                <input type="file" name="registrationQrImage" accept="image/*">
            </label>
            <p class="field-hint settings-media-hint">{{t 'public_submission_url_hint'}}: <code>/s/{{synagogue.slug}}/add-name</code></p>
        </article>
        <article class="settings-media-tile settings-control-tile settings-qr-scales-tile">
            <h4 class="settings-control-tile-title">{{t 'memorial_qr_sizes_title'}}</h4>
            <div class="settings-compact-sliders">
                <div class="slider-field-modern settings-slider-compact">
                    <label for="memorialQrTitleScale">{{t 'memorial_qr_title_scale'}}</label>
                    {{> admin-settings-number-stepper name="memorialQrTitleScale" id="memorialQrTitleScale" min="50" max="200" step="5"
                        value=memorialQrPanel.titleScale suffix="%" compact=true inputClass="memorial-qr-preview-input"}}
                </div>
                <div class="slider-field-modern settings-slider-compact">
                    <label for="memorialQrQrScale">{{t 'memorial_qr_size_scale'}}</label>
                    {{> admin-settings-number-stepper name="memorialQrQrScale" id="memorialQrQrScale" min="80" max="250" step="5"
                        value=memorialQrPanel.qrScale suffix="%" compact=true inputClass="memorial-qr-preview-input"}}
                </div>
            </div>
        </article>
