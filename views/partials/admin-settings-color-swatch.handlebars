<div class="settings-color-tile color-field-modern"{{#if role}} data-color-role="{{role}}"{{/if}}>
    <label class="settings-color-label" for="{{id}}">{{t labelKey}}</label>
    <input type="color" name="{{name}}" id="{{id}}" class="color-swatch-input settings-color-swatch"
        value="{{value}}">
    <input type="text" dir="auto" class="color-hex-display settings-color-hex" id="{{id}}Hex" readonly
        value="{{value}}" aria-hidden="true" tabindex="-1">
    {{#if unifiedHintKey}}
    <span class="settings-color-unified-hint field-hint" data-unified-only hidden>{{t unifiedHintKey}}</span>
    {{/if}}
    {{#if overriddenNote}}
    <span class="settings-color-overridden-note field-hint" data-unified-overridden-note hidden>🔒 {{t 'unified_colors_overridden'}}</span>
    {{/if}}
</div>
