<div class="settings-color-tile color-field-modern">
    <label class="settings-color-label" for="{{id}}">{{t labelKey}}</label>
    <input type="color" name="{{name}}" id="{{id}}" class="color-swatch-input settings-color-swatch"
        value="{{value}}">
    <input type="text" class="color-hex-display settings-color-hex" id="{{id}}Hex" readonly
        value="{{value}}" aria-hidden="true" tabindex="-1">
    {{#if helpKey}}
    <span class="field-hint settings-color-hint">{{t helpKey}}</span>
    {{/if}}
</div>
