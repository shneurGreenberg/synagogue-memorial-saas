<fieldset class="logo-bg-swatch-fieldset onboarding-logo-bg">
    <legend class="logo-bg-swatch-legend">{{onboardingT 'logo_bg_label'}}</legend>
    <div class="logo-bg-swatch-row" role="radiogroup" aria-label="{{onboardingT 'logo_bg_label'}}">
        <label class="logo-bg-swatch is-selected">
            <input type="radio" name="logoBackground" value="" checked>
            <span class="logo-bg-swatch-face logo-bg-swatch-face--transparent" aria-hidden="true"></span>
            <span class="logo-bg-swatch-label">{{onboardingT 'logo_bg_none'}}</span>
        </label>
        <label class="logo-bg-swatch">
            <input type="radio" name="logoBackground" value="white">
            <span class="logo-bg-swatch-face logo-bg-swatch-face--white" aria-hidden="true"></span>
            <span class="logo-bg-swatch-label">{{onboardingT 'logo_bg_white'}}</span>
        </label>
        <label class="logo-bg-swatch">
            <input type="radio" name="logoBackground" value="black">
            <span class="logo-bg-swatch-face logo-bg-swatch-face--black" aria-hidden="true"></span>
            <span class="logo-bg-swatch-label">{{onboardingT 'logo_bg_black'}}</span>
        </label>
    </div>
</fieldset>
