<div class="public-deceased-block" data-deceased-index="{{index}}">
    <div class="public-deceased-block-head">
        <h3 class="public-deceased-block-title">
            <span class="public-deceased-badge">{{block.deceasedBadgeLabel}}</span>
        </h3>
        <button type="button" class="public-remove-deceased" data-action="remove-deceased" hidden>{{publicT 'remove_deceased'}}</button>
    </div>

    <div class="public-deceased-row-relation">
        <label class="public-field public-field-relation">
            <span>{{publicT 'relation_label'}}</span>
            <select name="deceased[{{index}}][relationKey]" class="public-relation-select public-select-field" required>
                <option value="" disabled {{#unless block.relationKey}}selected{{/unless}}>{{publicT 'relation_select_placeholder'}}</option>
                {{#each relationOptions}}
                <option value="{{this.value}}" {{#if (eq ../block.relationKey this.value)}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
            </select>
        </label>
        <label class="public-field public-field-relation-other" {{#unless (eq block.relationKey 'other')}}hidden{{/unless}}>
            <span>{{publicT 'relation_other_label'}}</span>
            <input type="text" dir="auto" name="deceased[{{index}}][relationOther]" maxlength="120" value="{{block.relationOther}}" placeholder="{{publicT 'relation_other_placeholder'}}" {{#if (eq block.relationKey 'other')}}required{{/if}}>
        </label>
    </div>

    <div class="public-name-row">
        <label class="public-field">
            <span>{{publicT 'deceased_surname_label'}}</span>
            <input type="text" dir="auto" name="deceased[{{index}}][surname]" maxlength="120" required value="{{block.surname}}" placeholder="{{publicT 'deceased_surname_placeholder'}}">
        </label>
        <label class="public-field">
            <span>{{publicT 'deceased_first_name_label'}}</span>
            <input type="text" dir="auto" name="deceased[{{index}}][firstName]" maxlength="120" required value="{{block.firstName}}" placeholder="{{publicT 'deceased_first_name_placeholder'}}">
        </label>
    </div>

    <fieldset class="public-gender-field">
        <legend>{{publicT 'deceased_gender_label'}}</legend>
        <div class="public-pill-group public-gender-pills" role="radiogroup">
            <label class="public-pill-option">
                <input type="radio" name="deceased[{{index}}][deceasedGender]" value="male" {{#unless (eq block.deceasedGender 'female')}}checked{{/unless}} required>
                <span>{{publicT 'deceased_gender_short_male'}}</span>
            </label>
            <label class="public-pill-option">
                <input type="radio" name="deceased[{{index}}][deceasedGender]" value="female" {{#if (eq block.deceasedGender 'female')}}checked{{/if}}>
                <span>{{publicT 'deceased_gender_short_female'}}</span>
            </label>
        </div>
    </fieldset>

    <label class="public-field">
        <span>{{publicT 'father_name_label'}}</span>
        <input type="text" dir="auto" name="deceased[{{index}}][fatherName]" maxlength="120" required value="{{block.fatherName}}" placeholder="{{publicT 'father_name_placeholder'}}">
    </label>

    <fieldset class="public-death-mode-field" data-public-death-mode>
        <legend>{{publicT 'death_mode_legend'}}</legend>
        <div class="public-pill-group public-gender-pills" role="radiogroup">
            <label class="public-pill-option">
                <input type="radio" name="deceased[{{index}}][deathDateMode]" value="gregorian" class="public-death-mode-input" checked>
                <span>{{publicT 'death_mode_gregorian'}}</span>
            </label>
            <label class="public-pill-option">
                <input type="radio" name="deceased[{{index}}][deathDateMode]" value="hebrew" class="public-death-mode-input">
                <span>{{publicT 'death_mode_hebrew'}}</span>
            </label>
        </div>
    </fieldset>

    <div class="public-field public-field-hebrew-death" data-public-death-panel="hebrew" hidden>
        <span>{{publicT 'death_mode_hebrew'}}</span>
        <div class="public-hebrew-date-row">
            <select name="deceased[{{index}}][hebrewDay]" class="public-heb-select public-heb-day" aria-label="{{publicT 'hebrew_day'}}"><option value="">{{publicT 'hebrew_day'}}</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option><option value="7">7</option><option value="8">8</option><option value="9">9</option><option value="10">10</option><option value="11">11</option><option value="12">12</option><option value="13">13</option><option value="14">14</option><option value="15">15</option><option value="16">16</option><option value="17">17</option><option value="18">18</option><option value="19">19</option><option value="20">20</option><option value="21">21</option><option value="22">22</option><option value="23">23</option><option value="24">24</option><option value="25">25</option><option value="26">26</option><option value="27">27</option><option value="28">28</option><option value="29">29</option><option value="30">30</option></select>
            <select name="deceased[{{index}}][hebrewMonth]" class="public-heb-select public-heb-month" aria-label="{{publicT 'hebrew_month'}}"><option value="">{{publicT 'hebrew_month'}}</option><option value="7">{{publicT 'hm_7'}}</option><option value="8">{{publicT 'hm_8'}}</option><option value="9">{{publicT 'hm_9'}}</option><option value="10">{{publicT 'hm_10'}}</option><option value="11">{{publicT 'hm_11'}}</option><option value="12">{{publicT 'hm_12'}}</option><option value="13">{{publicT 'hm_13'}}</option><option value="1">{{publicT 'hm_1'}}</option><option value="2">{{publicT 'hm_2'}}</option><option value="3">{{publicT 'hm_3'}}</option><option value="4">{{publicT 'hm_4'}}</option><option value="5">{{publicT 'hm_5'}}</option><option value="6">{{publicT 'hm_6'}}</option></select>
            <input type="number" name="deceased[{{index}}][hebrewYear]" class="public-heb-year" min="3762" max="9999" placeholder="{{publicT 'hebrew_year'}}" dir="ltr">
        </div>
        <p class="public-sunset-hint">{{publicT 'hebrew_mode_hint'}}</p>
    </div>

    <label class="public-field public-field-death-date" data-public-death-panel="gregorian">
        <span>{{publicT 'death_date_label'}}</span>
        <input type="text" name="deceased[{{index}}][deathDate]" class="public-death-date-input" required value="{{block.deathDateDisplay}}" placeholder="{{publicT 'death_date_placeholder'}}" dir="ltr" autocomplete="off" maxlength="10">
    </label>

    <fieldset class="public-sunset-field" data-public-death-panel="gregorian">
        <legend>{{publicT 'sunset_legend'}}</legend>
        <div class="public-pill-group public-gender-pills public-sunset-pills" role="radiogroup">
            <label class="public-pill-option">
                <input type="radio" name="deceased[{{index}}][diedAfterSunset]" value="before" {{#unless block.diedAfterSunset}}checked{{/unless}}>
                <span>{{publicT 'sunset_before_short'}}</span>
            </label>
            <label class="public-pill-option">
                <input type="radio" name="deceased[{{index}}][diedAfterSunset]" value="after" {{#if block.diedAfterSunset}}checked{{/if}}>
                <span>{{publicT 'sunset_after_short'}}</span>
            </label>
        </div>
        <p class="public-sunset-hint">{{publicT 'sunset_field_hint'}}</p>
        <p class="public-hebrew-preview" data-public-hebrew-preview hidden>{{publicT 'hebrew_date_preview'}}: <strong></strong></p>
    </fieldset>

    {{#if inviteMode}}
    <div class="public-photo-section public-photo-section-inline">
        <h4 class="public-section-title">{{publicT 'photo_section_title'}}</h4>
        <p class="public-section-intro">{{publicT 'photo_section_intro'}}</p>
        <div class="photo-crop-editor public-photo-crop-editor" data-form="public-{{index}}">
            <div class="photo-crop-viewport public-photo-crop-viewport">
                <span class="photo-preview-empty">{{publicT 'photo_upload_label'}}</span>
            </div>
            <div class="photo-crop-controls" hidden>
                <label class="photo-crop-zoom-label">{{publicT 'photo_crop_zoom'}}</label>
                <input type="range" class="photo-crop-zoom" min="1" max="3" step="0.05" value="1">
                <span class="public-photo-crop-hint">{{publicT 'photo_crop_hint'}}</span>
            </div>
            <input type="hidden" name="deceased[{{index}}][photoCropX]" class="photo-crop-x" value="50">
            <input type="hidden" name="deceased[{{index}}][photoCropY]" class="photo-crop-y" value="50">
            <input type="hidden" name="deceased[{{index}}][photoCropZoom]" class="photo-crop-zoom-value" value="1">
            <label class="public-photo-upload-label">
                {{publicT 'photo_upload_label'}}
                <input type="file" name="deceased[{{index}}][photo]" accept="image/*">
            </label>
        </div>
    </div>
    {{/if}}
</div>
