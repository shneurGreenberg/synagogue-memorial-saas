<div class="public-deceased-block" data-deceased-index="{{index}}">
    <div class="public-deceased-block-head">
        <h3 class="public-deceased-block-title">{{publicT 'deceased_block_title'}}{{#if showIndex}} <span class="public-deceased-index">{{displayIndex}}</span>{{/if}}</h3>
        <button type="button" class="public-remove-deceased" data-action="remove-deceased" hidden>{{publicT 'remove_deceased'}}</button>
    </div>

    <div class="public-deceased-row-relation">
        <label class="public-field public-field-relation">
            <span>{{publicT 'relation_label'}}</span>
            <select name="deceased[{{index}}][relationKey]" class="public-relation-select" required>
                <option value="">{{publicT 'relation_label'}}</option>
                {{#each relationOptions}}
                <option value="{{this.value}}" {{#if (eq ../block.relationKey this.value)}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
            </select>
        </label>
        <label class="public-field public-field-relation-other" {{#unless (eq block.relationKey 'other')}}hidden{{/unless}}>
            <span>{{publicT 'relation_other_label'}}</span>
            <input type="text" name="deceased[{{index}}][relationOther]" maxlength="120" value="{{block.relationOther}}" placeholder="{{publicT 'relation_other_placeholder'}}" {{#if (eq block.relationKey 'other')}}required{{/if}}>
        </label>
    </div>

    <label class="public-field">
        <span>{{publicT 'name_label'}}</span>
        <input type="text" name="deceased[{{index}}][name]" maxlength="120" required value="{{block.name}}" placeholder="{{publicT 'name_placeholder'}}">
    </label>

    <label class="public-field">
        <span>{{publicT 'father_name_label'}}</span>
        <span class="public-field-hint">{{publicT 'father_name_hint'}}</span>
        <input type="text" name="deceased[{{index}}][fatherName]" maxlength="120" required value="{{block.fatherName}}" placeholder="{{publicT 'father_name_placeholder'}}">
    </label>

    <label class="public-field">
        <span>{{publicT 'death_date_label'}}</span>
        <input type="date" name="deceased[{{index}}][deathDate]" class="public-death-date-input" required value="{{block.deathDate}}" min="1800-01-01" max="2100-12-31">
    </label>

    <fieldset class="public-sunset-field">
        <legend>{{publicT 'sunset_legend'}}</legend>
        <label class="public-sunset-option">
            <input type="radio" name="deceased[{{index}}][diedAfterSunset]" value="before" {{#unless block.diedAfterSunset}}checked{{/unless}}>
            <span>{{publicT 'sunset_before'}}</span>
        </label>
        <label class="public-sunset-option">
            <input type="radio" name="deceased[{{index}}][diedAfterSunset]" value="after" {{#if block.diedAfterSunset}}checked{{/if}}>
            <span>{{publicT 'sunset_after'}}</span>
        </label>
    </fieldset>

    {{#if inviteMode}}
    <div class="public-photo-section public-photo-section-inline">
        <h4 class="public-section-title">{{publicT 'photo_section_title'}}</h4>
        <p class="public-section-intro">{{publicT 'photo_section_intro'}}</p>
        <div class="photo-crop-editor public-photo-crop-editor" data-form="public-{{index}}">
            <div class="photo-crop-viewport public-photo-crop-viewport">
                <span class="photo-preview-empty">{{publicT 'photo_upload_label'}}</span>
            </div>
            <div class="photo-crop-controls" hidden>
                <label class="photo-crop-zoom-label">{{publicT 'photo_crop_zoom'}}</label>
                <input type="range" class="photo-crop-zoom" min="1" max="3" step="0.05" value="1">
                <span class="public-photo-crop-hint">{{publicT 'photo_crop_hint'}}</span>
            </div>
            <input type="hidden" name="deceased[{{index}}][photoCropX]" class="photo-crop-x" value="50">
            <input type="hidden" name="deceased[{{index}}][photoCropY]" class="photo-crop-y" value="50">
            <input type="hidden" name="deceased[{{index}}][photoCropZoom]" class="photo-crop-zoom-value" value="1">
            <label class="public-photo-upload-label">
                {{publicT 'photo_upload_label'}}
                <input type="file" name="deceased[{{index}}][photo]" accept="image/*">
            </label>
        </div>
    </div>
    {{/if}}
</div>
