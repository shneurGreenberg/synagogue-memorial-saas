<div class="settings-copy-group">
    <h4 class="settings-copy-group-title">{{t 'board_title_single'}}</h4>
    <div class="settings-copy-grid settings-copy-grid--single">
        <div class="form-field">
            <label for="boardTitleText">{{t 'board_title_single'}}</label>
            <input type="text" name="boardTitleText" id="boardTitleText" class="form-control admin-input-modern"
                value="{{boardTitleText}}">
            <span class="field-hint">{{t 'board_title_single_help'}}</span>
        </div>
    </div>
</div>
<div class="settings-copy-group">
    <h4 class="settings-copy-group-title">{{t 'board_subtitle_section'}}</h4>
    <div class="settings-copy-grid settings-copy-grid--single">
        <div class="form-field form-field-checkbox">
            <label class="admin-checkbox-label">
                <input type="checkbox" name="boardSubtitleEnabled" id="boardSubtitleEnabled" value="1"
                    class="admin-checkbox memorial-qr-preview-input board-subtitle-enabled-toggle" {{#if boardSubtitle.enabled}}checked{{/if}}>
                <span>{{t 'board_subtitle_enabled'}}</span>
            </label>
        </div>
        <div class="board-subtitle-design-fields{{#unless boardSubtitle.enabled}} is-hidden{{/unless}}" id="boardSubtitleDesignFields" {{#unless boardSubtitle.enabled}}hidden{{/unless}}>
        <div class="form-field">
            <label for="boardSubtitleText">{{t 'board_subtitle_text'}}</label>
            <input type="text" name="boardSubtitleText" id="boardSubtitleText"
                class="form-control admin-input-modern memorial-qr-preview-input"
                value="{{boardSubtitle.text}}">
        </div>
        <input type="hidden" name="boardSubtitleFont" id="boardSubtitleFont" value="">
        <div class="board-subtitle-color-weight-row">
        <div class="form-field">
            <label for="boardSubtitleColor">{{t 'board_subtitle_color'}}</label>
            <input type="color" name="boardSubtitleColor" id="boardSubtitleColor"
                class="form-control admin-input-modern memorial-qr-preview-input"
                value="{{synagogue.theme.boardSubtitleColor}}">
        </div>
        <div class="form-field">
            <label for="boardSubtitleWeight">{{t 'board_subtitle_weight'}}</label>
            <select name="boardSubtitleWeight" id="boardSubtitleWeight"
                class="form-control admin-select-modern memorial-qr-preview-input">
                <option value="400" {{#if (eq synagogue.theme.boardSubtitleWeight '400')}}selected{{/if}}>400</option>
                <option value="500" {{#if (eq synagogue.theme.boardSubtitleWeight '500')}}selected{{/if}}>500</option>
                <option value="600" {{#if (eq synagogue.theme.boardSubtitleWeight '600')}}selected{{/if}}>600</option>
                <option value="700" {{#if (eq synagogue.theme.boardSubtitleWeight '700')}}selected{{/if}}>700</option>
            </select>
        </div>
        </div>
        </div>
    </div>
</div>
<div class="settings-copy-group">
    <h4 class="settings-copy-group-title">{{t 'donation_qr_texts_title'}}</h4>
    <p class="field-hint">{{t 'donation_qr_texts_help'}}</p>
    <div class="settings-copy-grid settings-copy-grid--single">
        <div class="form-field">
            <label for="donationQrTitle">{{t 'donation_qr_title_single'}}</label>
            <input type="text" name="donationQrTitle" id="donationQrTitle" class="form-control admin-input-modern memorial-qr-preview-input"
                value="{{memorialQrPanel.donationTitleText}}">
        </div>
        <div class="form-field">
            <label for="donationQrText">{{t 'donation_qr_text_single'}}</label>
            <input type="text" name="donationQrText" id="donationQrText" class="form-control admin-input-modern memorial-qr-preview-input"
                value="{{memorialQrPanel.donationTextText}}">
        </div>
    </div>
</div>
<div class="settings-copy-group">
    <h4 class="settings-copy-group-title">{{t 'registration_qr_texts_title'}}</h4>
    <p class="field-hint">{{t 'registration_qr_texts_help'}}</p>
    <div class="settings-copy-grid settings-copy-grid--single">
        <div class="form-field">
            <label for="memorialQrTitle">{{t 'memorial_qr_title_single'}}</label>
            <input type="text" name="memorialQrTitle" id="memorialQrTitle" class="form-control admin-input-modern memorial-qr-preview-input"
                value="{{memorialQrPanel.titleText}}">
        </div>
        <div class="form-field">
            <label for="memorialQrText">{{t 'memorial_qr_text_single'}}</label>
            <input type="text" name="memorialQrText" id="memorialQrText" class="form-control admin-input-modern memorial-qr-preview-input"
                value="{{memorialQrPanel.textText}}">
        </div>
    </div>
</div>
