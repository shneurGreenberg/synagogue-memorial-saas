{{!-- 1.32.0 I42: phone home screen: board preview, then big tiles (2 per row). --}}
<div class="admin-home">
    <div class="admin-home-preview" aria-hidden="true">
        <div class="admin-home-preview-frame-wrap">
            <iframe class="admin-home-preview-frame" src="/s/{{synagogue.slug}}?preview=1" title="{{t 'live_preview'}}" tabindex="-1" loading="lazy"></iframe>
        </div>
    </div>
    <nav class="admin-home-tiles" aria-label="{{t 'admin_home_menu'}}">
        {{#if adminPermissions.people}}
        <a class="admin-home-tile" href="/admin/{{synagogue.slug}}/people">
            <svg class="admin-home-tile-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
            <span class="admin-home-tile-name">{{t 'people'}}</span>
            {{#if missingGenderCount}}<span class="admin-home-tile-badge admin-home-tile-badge--warn">{{missingGenderCount}} {{t 'home_badge_missing_gender'}}</span>
            {{else}}{{#if peopleCount}}<span class="admin-home-tile-badge">{{peopleCount}}</span>{{/if}}{{/if}}
        </a>
        <a class="admin-home-tile" href="/admin/{{synagogue.slug}}/yahrzeit">
            <svg class="admin-home-tile-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2c-1.1 0-2 .9-2 2v1.07C7.06 5.56 5 7.92 5 11v5l-2 2v1h18v-1l-2-2v-5c0-3.08-2.06-5.44-5-5.93V4c0-1.1-.9-2-2-2m0 2c.55 0 1 .45 1 1v1h-2V5c0-.55.45-1 1-1m-1 9h2v3h-2v-3Z"/></svg>
            <span class="admin-home-tile-name">{{t 'yahrzeit_page'}}</span>
            {{#if yahrzeitTodayCount}}<span class="admin-home-tile-badge admin-home-tile-badge--alert">{{yahrzeitTodayCount}} {{t 'home_badge_today'}}</span>
            {{else}}{{#if yahrzeitWeekCount}}<span class="admin-home-tile-badge">{{yahrzeitWeekCount}} {{t 'home_badge_this_week'}}</span>{{/if}}{{/if}}
        </a>
        {{/if}}
        {{#if adminPermissions.events}}
        <a class="admin-home-tile" href="/admin/{{synagogue.slug}}/events">
            {{{adminIcon 'announcement' class='admin-home-tile-icon'}}}
            <span class="admin-home-tile-name">{{t 'board_content'}}</span>
        </a>
        {{/if}}
        {{#if adminPermissions.settings}}
        <a class="admin-home-tile" href="/admin/{{synagogue.slug}}/dashboard">
            <svg class="admin-home-tile-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 15.5A3.5 3.5 0 1 1 12 8.5a3.5 3.5 0 0 1 0 7m7.43-2.53c.04-.32.07-.64.07-.97s-.03-.66-.07-1l2.11-1.63c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.31-.61-.22l-2.49 1c-.52-.39-1.06-.73-1.69-.98l-.37-2.65A.5.5 0 0 0 14 2h-4c-.25 0-.46.18-.5.42l-.37 2.65c-.63.25-1.17.59-1.69.98l-2.49-1c-.22-.09-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64L4.57 11c-.04.34-.07.67-.07 1s.03.65.07.97l-2.11 1.66c-.19.15-.25.42-.12.64l2 3.46c.12.22.39.3.61.22l2.49-1.01c.52.4 1.06.74 1.69.99l.37 2.65c.04.24.25.42.5.42h4c.25 0 .46-.18.5-.42l.37-2.65c.63-.26 1.17-.59 1.69-.99l2.49 1.01c.22.08.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.66Z"/></svg>
            <span class="admin-home-tile-name">{{t 'board_settings'}}</span>
        </a>
        {{/if}}
        <a class="admin-home-tile" href="/admin/{{synagogue.slug}}/users">
            <svg class="admin-home-tile-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3m-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3m0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5m8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5Z"/></svg>
            <span class="admin-home-tile-name">{{#if canManageUsers}}{{t 'user_management'}}{{else}}{{t 'my_admin_preferences'}}{{/if}}</span>
        </a>
        <a class="admin-home-tile admin-home-tile--board" href="/s/{{synagogue.slug}}" target="_blank" rel="noopener">
            <svg class="admin-home-tile-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21 3H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h5v2h8v-2h5c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2m0 14H3V5h18v12Z"/></svg>
            <span class="admin-home-tile-name">{{t 'view_board'}}</span>
        </a>
        <a class="admin-home-tile admin-home-tile--muted" href="/admin/logout">
            <svg class="admin-home-tile-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5-5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/></svg>
            <span class="admin-home-tile-name">{{t 'logout'}}</span>
        </a>
    </nav>
</div>
