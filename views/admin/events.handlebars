<div class="admin-page events-page">
    <header class="admin-page-header">
        <div>
            <h1>{{t 'community_events'}}</h1>
            <p class="admin-subtitle">{{t 'community_events_subtitle'}}</p>
        </div>
    </header>

    <div id="eventsStatusBanner" class="admin-alert events-status-banner events-status-banner--success" hidden aria-live="polite"></div>


{{#if upcomingHolidayNotice}}
<section class="admin-alert admin-alert-info upcoming-holiday-notice" role="status">
    <strong>{{t 'upcoming_holiday_notice_title'}}:</strong>
    <span>{{upcomingHolidayNotice.title}}</span>
    <span class="upcoming-holiday-notice-date">{{upcomingHolidayNotice.date}}</span>
</section>
{{/if}}


<section class="admin-panel slideshow-compact" id="slideshow-section">
    <div class="admin-panel-header">
        <h2>{{t 'slideshow'}}</h2>
        <p class="admin-subtitle">{{t 'slideshow_subtitle'}}</p>
    </div>
    <div class="admin-panel-body">
        <form method="POST" action="/admin/{{synagogue.slug}}/slideshow/settings" class="slideshow-panel-form"
            id="slideshowPanelForm">
            <label class="toggle-switch slideshow-enable-toggle">
                <input type="checkbox" name="enabled" {{#if synagogue.slideshow.enabled}}checked{{/if}}>
                <span class="toggle-slider"></span>
                <span class="toggle-label">{{t 'enable_slideshow'}}</span>
            </label>

            <fieldset class="slideshow-mode-fieldset">
                <legend class="sr-only">{{t 'slideshow_display_mode'}}</legend>
                <label class="slideshow-mode-option">
                    <input type="radio" name="displayMode" value="showNow"
                        {{#if synagogue.slideshow.isShowNowMode}}checked{{/if}}>
                    <span>{{t 'slideshow_mode_show_now'}}</span>
                </label>
                <label class="slideshow-mode-option">
                    <input type="radio" name="displayMode" value="rotate"
                        {{#unless synagogue.slideshow.isShowNowMode}}checked{{/unless}}>
                    <span>{{t 'slideshow_mode_rotate'}}</span>
                </label>
            </fieldset>

            <div class="slideshow-rotate-fields" id="slideshowRotateFields"
                {{#if synagogue.slideshow.isShowNowMode}}hidden{{/if}}>
                <div class="settings-two-col">
                    <div class="form-field">
                        <label for="slideInterval">{{t 'slide_duration'}}</label>
                        <input type="number" class="form-control admin-input-modern" name="interval" id="slideInterval"
                            value="{{synagogue.slideshow.interval}}" min="3">
                    </div>
                    <div class="form-field">
                        <label for="mainDuration">{{t 'main_duration'}}</label>
                        <input type="number" class="form-control admin-input-modern" name="mainDuration" id="mainDuration"
                            value="{{synagogue.slideshow.mainDuration}}" min="10">
                    </div>
                </div>
            </div>

            <div class="slideshow-current-block">
                <p class="slideshow-current-label">{{t 'slideshow_current_image'}}</p>
                <div class="media-preview media-preview-slide slideshow-current-preview" id="slideshowCurrentPreview">
                    {{#if synagogue.slideshow.currentSlide}}
                    <img src="/images/{{synagogue.slideshow.currentSlide.url}}" alt="">
                    {{else}}
                    <span class="media-preview-empty">{{t 'no_slides'}}</span>
                    {{/if}}
                </div>
                <label class="file-drop-label slideshow-upload-label">
                    {{t 'replace_image'}}
                    <input type="file" name="image" accept="image/*" id="slideshowImageInput"
                        data-upload-url="/admin/{{synagogue.slug}}/slideshow/add">
                </label>
                <p class="field-hint">{{t 'slideshow_upload_hint'}}</p>
            </div>

            <button type="submit" class="btn-admin btn-admin-primary">{{t 'save'}}</button>
        </form>
    </div>
</section>

<script>
    window.slideshowAdminLabels = {
        saving: '{{t 'saving'}}',
        saved: '{{t 'saved'}}',
        noSlides: '{{t 'no_slides'}}',
        uploadPhoto: '{{t 'upload_photo'}}',
        uploadFailed: '{{t 'upload_error'}}'
    };
    window.slideshowAdminConfig = {
        uploadUrl: '/admin/{{synagogue.slug}}/slideshow/add'
    };
</script>


    <section class="admin-panel">
        <div class="admin-panel-header">
            <h2>{{t 'add_community_event'}}</h2>
        </div>
        <div class="admin-panel-body events-form-layout">
            <form method="POST" action="/admin/{{synagogue.slug}}/events/add" class="add-event-form events-editor-form" id="addEventForm">
                <div class="events-editor-fields">
                <div class="form-field">
                    <label for="eventTitle">{{t 'event_title'}}</label>
                    <input type="text" name="title" id="eventTitle" class="form-control admin-input-modern event-preview-input"
                        placeholder="{{t 'event_title_placeholder'}}" required>
                </div>
                <div class="form-field">
                    <label for="eventText">{{t 'event_description_optional'}}</label>
                    <textarea name="text" id="eventText" class="form-control admin-input-modern event-preview-input" rows="3"
                        placeholder="{{t 'event_description_placeholder'}}"></textarea>
                </div>

                <div class="form-field events-event-date-block">
                    <span class="form-field-label">{{t 'event_date_label'}}</span>
                    <p class="field-hint">{{t 'event_date_help'}}</p>
                    <div class="date-inputs-row">
                        <input type="number" name="eventMonth" id="eventMonth" class="form-control admin-input-modern event-preview-input"
                            min="1" max="12" placeholder="{{t 'month'}}" aria-label="{{t 'month'}}">
                        <input type="number" name="eventDate" id="eventDay" class="form-control admin-input-modern event-preview-input"
                            min="1" max="31" placeholder="{{t 'day'}}" aria-label="{{t 'day'}}">
                        <input type="number" name="eventYear" id="eventYear" class="form-control admin-input-modern event-preview-input"
                            min="1900" max="2100" placeholder="{{t 'year'}}" aria-label="{{t 'year'}}">
                    </div>
                </div>

                <div class="events-scheduling-block">
                    <h3 class="events-scheduling-title">{{t 'event_scheduling_section'}}</h3>

                    <div class="settings-two-col events-visibility-row">
                        <div class="form-field">
                            <label for="eventStartAt">{{t 'event_start_at'}}</label>
                            <input type="datetime-local" name="startAt" id="eventStartAt"
                                class="form-control admin-input-modern">
                        </div>
                        <div class="form-field">
                            <label for="eventEndAt">{{t 'event_end_at'}}</label>
                            <input type="datetime-local" name="endAt" id="eventEndAt"
                                class="form-control admin-input-modern">
                        </div>
                    </div>
                    <p class="field-hint events-scheduling-hint">{{t 'event_scheduling_hint'}}</p>

                    <div class="event-form-actions events-scheduling-actions">
                        <button type="submit" class="btn-admin btn-admin-primary btn-admin-with-icon" data-publish-now="0">
                            {{{adminIcon 'schedule' class='btn-admin-inline-icon'}}}
                            {{t 'schedule_event'}}
                        </button>
                        <button type="submit" class="btn-admin btn-admin-accent btn-admin-with-icon" data-publish-now="1">
                            {{{adminIcon 'publish' class='btn-admin-inline-icon'}}}
                            {{t 'publish_now'}}
                        </button>
                    </div>
                </div>
                </div>

                <aside class="events-board-preview" id="eventsBoardPreview"
                    data-board-lang="{{synagogue.language}}"
                    style="--primary-color: {{synagogue.theme.primaryColor}}; --text-color: {{synagogue.theme.textColor}}; --accent-color: {{synagogue.theme.accentColor}};">
                    <h3 class="events-board-preview-title">{{t 'event_board_preview_title'}}</h3>
                    <div class="events-board-preview-panel">
                        <h4 class="events-board-preview-section" id="eventsPreviewSectionTitle">{{t 'sidebar_upcoming_title'}}</h4>
                        <ul class="events-board-preview-list">
                            <li class="community-event-item events-board-preview-item">
                                <div class="community-event-link" role="note">
                                    <span class="community-event-title" id="eventsPreviewTitle">{{t 'event_board_preview_title_sample'}}</span>
                                    <time id="eventsPreviewDate" hidden>{{t 'event_board_preview_date_sample'}}</time>
                                    <span class="community-event-text" id="eventsPreviewText">{{t 'event_board_preview_text_sample'}}</span>
                                </div>
                            </li>
                        </ul>
                    </div>
                </aside>
            </form>
        </div>
    </section>

    <section class="admin-panel" id="activeEventsPanel">
        <div class="admin-panel-header">
            <h2>{{t 'active_events'}}</h2>
        </div>
        <div class="admin-panel-body">
            <div class="events-list" id="activeEventsList" data-section="active"></div>
        </div>
    </section>

    <section class="admin-panel" id="scheduledEventsPanel">
        <div class="admin-panel-header">
            <h2>{{t 'scheduled_events'}}</h2>
        </div>
        <div class="admin-panel-body">
            <div class="events-list" id="scheduledEventsList" data-section="scheduled"></div>
        </div>
    </section>

    <section class="admin-panel" id="historyEventsPanel">
        <div class="admin-panel-header">
            <h2>{{t 'events_history'}}</h2>
        </div>
        <div class="admin-panel-body">
            <div class="events-list events-list-history" id="historyEventsList" data-section="history"></div>
        </div>
    </section>
</div>

<div class="modal fade admin-modal" id="editEventModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="POST" action="/admin/{{synagogue.slug}}/events/edit" id="editEventForm">
                <input type="hidden" name="eventId" id="editEventId">
                <div class="modal-header">
                    <h5 class="modal-title">{{t 'edit_event'}}</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="{{t 'cancel'}}">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="form-field">
                        <label for="editEventTitle">{{t 'event_title'}}</label>
                        <input type="text" name="title" id="editEventTitle" class="form-control admin-input-modern" required>
                    </div>
                    <div class="form-field">
                        <label for="editEventText">{{t 'event_description_optional'}}</label>
                        <textarea name="text" id="editEventText" class="form-control admin-input-modern" rows="3"></textarea>
                    </div>

                    <div class="form-field events-event-date-block">
                        <span class="form-field-label">{{t 'event_date_label'}}</span>
                        <div class="date-inputs-row">
                            <input type="number" name="eventMonth" id="editEventMonth" class="form-control admin-input-modern"
                                min="1" max="12" placeholder="{{t 'month'}}" aria-label="{{t 'month'}}">
                            <input type="number" name="eventDate" id="editEventDay" class="form-control admin-input-modern"
                                min="1" max="31" placeholder="{{t 'day'}}" aria-label="{{t 'day'}}">
                            <input type="number" name="eventYear" id="editEventYear" class="form-control admin-input-modern"
                                min="1900" max="2100" placeholder="{{t 'year'}}" aria-label="{{t 'year'}}">
                        </div>
                    </div>
                    <div class="events-scheduling-block events-scheduling-block--compact">
                        <div class="settings-two-col events-visibility-row">
                            <div class="form-field">
                                <label for="editEventStartAt">{{t 'event_start_at'}}</label>
                                <input type="datetime-local" name="startAt" id="editEventStartAt"
                                    class="form-control admin-input-modern">
                            </div>
                            <div class="form-field">
                                <label for="editEventEndAt">{{t 'event_end_at'}}</label>
                                <input type="datetime-local" name="endAt" id="editEventEndAt"
                                    class="form-control admin-input-modern">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-admin btn-admin-ghost btn-admin-with-icon" data-dismiss="modal">{{{adminIcon 'cancel' class='btn-admin-inline-icon'}}}{{t 'cancel'}}</button>
                    <button type="submit" class="btn-admin btn-admin-primary btn-admin-with-icon">{{{adminIcon 'save' class='btn-admin-inline-icon'}}}{{t 'save_changes'}}</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    window.eventsAdminLabels = {
        saving: '{{t 'saving'}}',
        saved: '{{t 'saved'}}',
        eventSaved: '{{t 'event_saved'}}',
        eventDeleted: '{{t 'event_deleted'}}',
        eventSaveFailed: '{{t 'event_save_failed'}}',
        areYouSure: '{{t 'are_you_sure'}}',
        edit: '{{t 'edit'}}',
        delete: '{{t 'delete'}}',
        publishNow: '{{t 'publish_now'}}',
        endNow: '{{t 'end_now'}}',
        noActiveEvents: '{{t 'no_active_events'}}',
        noScheduledEvents: '{{t 'no_scheduled_events'}}',
        noHistoryEvents: '{{t 'no_history_events'}}',
        eventStartAt: '{{t 'event_start_at'}}',
        eventEndAt: '{{t 'event_end_at'}}',
        eventStartRequired: '{{t 'event_start_required'}}',
        eventTitleRequired: '{{t 'event_title_required'}}',
        month: '{{t 'month'}}',
        day: '{{t 'day'}}',
        year: '{{t 'year'}}',
        moveUp: '{{t 'event_move_up'}}',
        moveDown: '{{t 'event_move_down'}}',
    };
    window.eventsAdminSlug = '{{synagogue.slug}}';
    window.eventsBoardLang = '{{synagogue.language}}';
    window.eventsPreviewLabels = {
        ru: {
            sectionTitle: '{{t 'sidebar_upcoming_title'}}',
            titleSample: '{{t 'event_board_preview_title_sample'}}',
            textSample: '{{t 'event_board_preview_text_sample'}}',
            dateSample: '{{t 'event_board_preview_date_sample'}}',
        },
        en: {
            sectionTitle: 'Upcoming dates & announcements',
            titleSample: 'Community event',
            textSample: 'Additional details for the announcement',
            dateSample: '15 March / 15 Adar',
        },
    };
</script>
<script id="events-data" type="application/json">{{{json events}}}</script>
