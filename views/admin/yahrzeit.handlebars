<div class="admin-page yahrzeit-page" data-synagogue-slug="{{synagogue.slug}}" data-copy-label="{{t 'yahrzeit_copy_message'}}" data-copied-label="{{t 'yahrzeit_copied'}}" data-send-label="{{t 'yahrzeit_send_contact'}}" data-date-label="{{t 'date_of_death'}}" data-delete-confirm="{{t 'are_you_sure'}}" data-no-bio-label="{{t 'person_card_no_biography'}}" data-platform-whatsapp="{{t 'contact_platform_whatsapp'}}" data-platform-telegram="{{t 'contact_platform_telegram'}}" data-platform-max="{{t 'contact_platform_max'}}" data-platform-sms="{{t 'contact_platform_sms'}}" data-platform-email="{{t 'contact_platform_email'}}">
    <header class="admin-page-header">
        <div>
            <h1>{{t 'yahrzeit_page'}}</h1>
            <p class="admin-subtitle">{{t 'yahrzeit_subtitle'}} · {{todayLabel}}</p>
        </div>
    </header>

{{#if upcomingHolidayNotice}}
<section class="admin-alert admin-alert-info upcoming-holiday-notice" role="status">
    <strong>{{t 'upcoming_holiday_notice_title'}}:</strong>
    <span>{{upcomingHolidayNotice.title}}</span>
    <span class="upcoming-holiday-notice-date">{{upcomingHolidayNotice.date}}</span>
</section>
{{/if}}

<section class="admin-panel yahrzeit-upcoming-section">
    <details class="yahrzeit-upcoming-details">
        <summary class="yahrzeit-upcoming-heading" id="yahrzeit-upcoming-week-title">
            <span class="yahrzeit-upcoming-summary-row">
                <span class="yahrzeit-upcoming-chevron" aria-hidden="true"></span>
                <span class="yahrzeit-upcoming-title-text">{{t 'yahrzeit_upcoming_week_title'}}</span>
                <span class="yahrzeit-upcoming-count-badge{{#unless upcomingWeek.length}} is-zero{{/unless}}">{{upcomingWeek.length}}</span>
            </span>
        </summary>
        {{#if upcomingWeek.length}}
        <table class="yahrzeit-upcoming-table">
            <thead>
                <tr>
                    <th scope="col">{{t 'name'}}</th>
                    <th scope="col">{{t 'yahrzeit_upcoming_hebrew_col'}}</th>
                    <th scope="col">{{t 'yahrzeit_upcoming_gregorian_col'}}</th>
                </tr>
            </thead>
            <tbody>
                {{#each upcomingWeek}}
                <tr>
                    <td>
                        <a href="/admin/{{@root.synagogue.slug}}/people?q={{this.searchQuery}}" class="yahrzeit-upcoming-name-link">{{this.name}}</a>
                    </td>
                    <td>{{this.hebrewDateLabel}}</td>
                    <td dir="ltr">{{this.gregorianDateLabel}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
        {{else}}
        <p class="seed-notice">{{t 'yahrzeit_upcoming_empty'}}</p>
        {{/if}}
    </details>
</section>

<section class="admin-panel yahrzeit-upcoming-section">
    <details class="yahrzeit-upcoming-details">
        <summary class="yahrzeit-upcoming-heading" id="yahrzeit-upcoming-month-title">
            <span class="yahrzeit-upcoming-summary-row">
                <span class="yahrzeit-upcoming-chevron" aria-hidden="true"></span>
                <span class="yahrzeit-upcoming-title-text">{{t 'yahrzeit_upcoming_month_title'}}</span>
                <span class="yahrzeit-upcoming-count-badge{{#unless upcomingMonth.length}} is-zero{{/unless}}">{{upcomingMonth.length}}</span>
            </span>
        </summary>
        {{#if upcomingMonth.length}}
        <table class="yahrzeit-upcoming-table">
            <thead>
                <tr>
                    <th scope="col">{{t 'name'}}</th>
                    <th scope="col">{{t 'yahrzeit_upcoming_hebrew_col'}}</th>
                    <th scope="col">{{t 'yahrzeit_upcoming_gregorian_col'}}</th>
                </tr>
            </thead>
            <tbody>
                {{#each upcomingMonth}}
                <tr>
                    <td>
                        <a href="/admin/{{@root.synagogue.slug}}/people?q={{this.searchQuery}}" class="yahrzeit-upcoming-name-link">{{this.name}}</a>
                    </td>
                    <td>{{this.hebrewDateLabel}}</td>
                    <td dir="ltr">{{this.gregorianDateLabel}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
        {{else}}
        <p class="seed-notice">{{t 'yahrzeit_upcoming_empty'}}</p>
        {{/if}}
    </details>
</section>

{{#if weeklyKaddishReminderEnabled}}
{{#if weeklyKaddish}}
<section id="weekly-kaddish" class="admin-panel weekly-kaddish-panel">
    <details class="weekly-kaddish-details">
        <summary class="weekly-kaddish-summary">
            {{t 'weekly_kaddish_summary'}}
            <span class="weekly-kaddish-range">{{weeklyKaddish.weekStartKey}} – {{weeklyKaddish.weekEndKey}}</span>
        </summary>
        <div class="weekly-kaddish-details-body">
            <ul class="weekly-kaddish-list">
                {{#each weeklyKaddish.entries}}
                <li class="weekly-kaddish-item{{#if this.missingContact}} is-missing{{/if}}">
                    <a href="/admin/{{@root.synagogue.slug}}/people?q={{this.searchQuery}}" class="weekly-kaddish-name">{{this.name}}</a>
                    <span class="weekly-kaddish-date">{{this.weekdayHe}} {{this.gregorianLabel}} · {{this.hebrewLabel}}</span>
                    {{#if this.contacts.length}}
                    <span class="weekly-kaddish-contacts">
                        {{#each this.contacts}}<span class="weekly-kaddish-contact">{{this.name}}{{#if this.phone}} · {{this.phone}}{{/if}}{{#if this.email}} · {{this.email}}{{/if}}</span>{{/each}}
                    </span>
                    {{/if}}
                    {{#if this.missingContact}}<span class="weekly-kaddish-missing">{{t 'weekly_kaddish_missing_contact'}}</span>{{/if}}
                </li>
                {{/each}}
            </ul>
            <div class="weekly-kaddish-actions">
                {{#if weeklyKaddish.confirmed}}
                <span class="weekly-kaddish-confirmed">✓ {{t 'weekly_kaddish_confirmed_by'}} {{weeklyKaddish.confirmedBy}} · {{weeklyKaddish.confirmedAtLabel}}</span>
                <button type="button" id="weeklyKaddishSend" class="btn-admin btn-admin-primary" data-wa-url="{{weeklyKaddish.whatsappUrl}}" data-copied-label="{{t 'weekly_kaddish_copied_set_number'}}">{{t 'weekly_kaddish_send_whatsapp'}}</button>
                <textarea dir="auto" id="weeklyKaddishMessage" hidden readonly>{{weeklyKaddish.message}}</textarea>
                {{else}}
                <form method="POST" action="/admin/{{synagogue.slug}}/yahrzeit/weekly-confirm" class="weekly-kaddish-confirm-form">
                    <button type="submit" class="btn-admin btn-admin-primary">{{t 'weekly_kaddish_confirm'}}</button>
                </form>
                {{/if}}
            </div>
        </div>
    </details>
</section>
{{/if}}
{{/if}}

    {{!-- 1.34.0 I53: phone notifications for the installed admin app. Turned on only by an explicit
         click, never automatically. --}}
    <section class="admin-panel yahrzeit-push-panel" id="yahrzeitPushPanel"
        data-slug="{{synagogue.slug}}"
        data-supported="{{#if yahrzeitPushSupported}}1{{else}}0{{/if}}"
        data-public-key="{{yahrzeitPushPublicKey}}"
        data-enabled="{{#if yahrzeitPush.enabled}}1{{else}}0{{/if}}">
        <div class="admin-panel-header">
            <h2 class="admin-panel-title">
                <svg class="admin-panel-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 22a2 2 0 0 0 2-2h-4a2 2 0 0 0 2 2m6-6V11a6 6 0 0 0-5-5.91V4a1 1 0 1 0-2 0v1.09A6 6 0 0 0 6 11v5l-2 2v1h16v-1l-2-2Z"/></svg>
                {{t 'yahrzeit_push_title'}}
            </h2>
        </div>
        <div class="admin-panel-body">
            <p class="field-hint">{{t 'yahrzeit_push_hint'}}</p>

            {{#unless yahrzeitPushSupported}}
            <p class="admin-alert admin-alert-warning" role="status">{{t 'yahrzeit_push_not_configured'}}</p>
            {{/unless}}

            <form method="POST" action="/admin/{{synagogue.slug}}/push/settings" class="yahrzeit-push-form"
                data-mobile-save="1" data-mobile-save-label="{{t 'save'}}">
                <div class="admin-theme-setting">
                    <div class="admin-theme-setting-label">{{t 'yahrzeit_push_enable'}}</div>
                    <div class="admin-theme-setting-control">
                        <label class="toggle-switch" for="yahrzeitPushEnabled">
                            <input type="hidden" name="yahrzeitPushEnabled" value="0">
                            <input type="checkbox" id="yahrzeitPushEnabled" name="yahrzeitPushEnabled" value="1"
                                {{#if yahrzeitPush.enabled}}checked{{/if}}>
                            <span class="toggle-slider" aria-hidden="true"></span>
                        </label>
                    </div>
                </div>
                <div class="admin-theme-setting">
                    <label class="admin-theme-setting-label" for="yahrzeitPushDaysBefore">{{t 'yahrzeit_push_days_before'}}</label>
                    <div class="admin-theme-setting-control">
                        <input type="number" class="form-control admin-input-modern" name="yahrzeitPushDaysBefore"
                            id="yahrzeitPushDaysBefore" min="0" max="60" step="1" value="{{yahrzeitPush.daysBefore}}">
                    </div>
                </div>
                <div class="form-actions-sticky">
                    <button type="submit" class="btn-admin btn-admin-primary" data-mobile-save-primary>{{t 'save'}}</button>
                </div>
            </form>

            <div class="yahrzeit-push-subscribe">
                <button type="button" class="btn-admin btn-admin-secondary" id="yahrzeitPushSubscribeBtn">
                    {{t 'yahrzeit_push_subscribe'}}
                </button>
                <button type="button" class="btn-admin btn-admin-ghost" id="yahrzeitPushTestBtn">
                    {{t 'yahrzeit_push_test'}}
                </button>
                <p class="yahrzeit-push-status" id="yahrzeitPushStatus" role="status">{{t 'yahrzeit_push_status_idle'}}</p>
                <p class="field-hint">{{t 'yahrzeit_push_devices'}} <strong>{{yahrzeitPushSubscribers}}</strong></p>
            </div>
        </div>
    </section>

    {{#if weeklyKaddishReminderEnabled}}
    <form method="POST" action="/admin/{{synagogue.slug}}/yahrzeit/settings" class="yahrzeit-settings-form board-features-grid">
        <p class="yahrzeit-settings-saved" id="yahrzeitSettingsSaved" data-saved-label="{{t 'saved_settings'}}" hidden role="status">{{t 'saved_settings'}}</p>
        <div class="admin-theme-setting">
            <label class="admin-theme-setting-label" for="weeklyKaddishWhatsapp">{{t 'weekly_kaddish_whatsapp_setting'}}</label>
            <div class="admin-theme-setting-control">
                <input type="tel" id="weeklyKaddishWhatsapp" name="weeklyKaddishWhatsapp" value="{{weeklyKaddishWhatsapp}}" placeholder="972501234567" dir="ltr" class="form-control">
            </div>
        </div>
    </form>
    {{/if}}

    {{#if entries.length}}
    <div class="yahrzeit-list">
        {{#each entries}}
        <article class="yahrzeit-card yahrzeit-card-clickable" id="person-{{this.id}}" data-person-id="{{this.id}}">
            <div class="yahrzeit-card-layout">
                <div class="yahrzeit-tile-preview yahrzeit-card-open" style="--primary-color: {{../synagogue.theme.primaryColor}}; --text-color: {{../synagogue.theme.textColor}}; --accent-color: {{../synagogue.theme.accentColor}};">
                    {{#if this.photoUrl}}
                    <img class="yahrzeit-tile-photo" src="{{this.photoUrl}}" alt="{{this.name}}">
                    {{else}}
                    <div class="yahrzeit-tile-photo yahrzeit-tile-placeholder">{{initials this.name}}</div>
                    {{/if}}
                    <div class="yahrzeit-tile-body">
                        <h2>{{this.name}}</h2>
                        {{#if this.yahrzeitKindLabel}}
                        <p class="yahrzeit-kind-label">{{this.yahrzeitKindLabel}}</p>
                        {{/if}}
                        {{#if (or this.gregorianDateLabel this.hebrewDateLabel)}}
                        <p class="yahrzeit-date-label">{{this.gregorianDateLabel}}{{#if (and this.gregorianDateLabel this.hebrewDateLabel)}} · {{/if}}{{this.hebrewDateLabel}}</p>
                        {{/if}}
                    </div>
                    <div class="yahrzeit-tile-candle" aria-hidden="true">🕯</div>
                </div>

                    <div class="yahrzeit-details">
                        {{#if this.contacts.length}}
                        {{#each this.contacts}}
                        <div class="yahrzeit-contact-block">
                            <h3>{{t 'contact_section'}}{{#if this.contact.name}} — {{this.contact.name}}{{/if}}</h3>
                            {{#if this.hasContactDetails}}
                            {{#if this.contact.phone}}
                            <p><strong>{{t 'contact_phone'}}:</strong> {{this.contact.phone}}</p>
                            {{/if}}
                            {{#if this.contact.email}}
                            <p><strong>{{t 'contact_email'}}:</strong> {{this.contact.email}}</p>
                            {{/if}}
                            {{#if this.contact.platform}}
                            {{#if (or this.contact.phone this.contact.email)}}
                            <p><strong>{{t 'contact_platform'}}:</strong> {{this.contactPlatformLabel}}</p>
                            {{/if}}
                            {{/if}}
                            {{else}}
                            <p class="seed-notice">{{t 'yahrzeit_no_contact'}}</p>
                            {{/if}}

                            <div class="yahrzeit-message-block">
                                <h3>{{t 'yahrzeit_prepared_message'}}</h3>
                                <textarea dir="auto" class="form-control yahrzeit-message" rows="8" data-person-id="{{../id}}" data-contact-index="{{this.contactIndex}}" data-missed="0">{{this.preparedMessage}}</textarea>
                                <div class="yahrzeit-actions">
                                    <button type="button" class="btn-admin btn-admin-secondary yahrzeit-copy-btn btn-admin-with-icon" data-message="{{this.preparedMessage}}">
                                        <svg class="btn-admin-inline-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg>
                                        {{t 'yahrzeit_copy_message'}}
                                    </button>
                                    {{#if this.contactLink}}
                                    <a href="{{this.contactLink}}" class="btn-admin btn-admin-primary yahrzeit-send-btn btn-admin-with-icon" data-person-id="{{../id}}" data-contact-index="{{this.contactIndex}}" data-person-name="{{../name}}" data-export-url="/s/{{../../synagogue.slug}}/card/{{../id}}?export=1" target="_blank" rel="noopener noreferrer">
                                        <svg class="btn-admin-inline-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M2.01 21 23 12 2.01 3 2 10l15 2-15 2z"/></svg>
                                        {{t 'yahrzeit_send_contact'}}
                                    </a>
                                    {{/if}}
                                </div>
                            </div>
                        </div>
                        {{/each}}
                        {{else}}
                        <div class="yahrzeit-contact-block">
                            <h3>{{t 'contact_section'}}</h3>
                            <p class="seed-notice">{{t 'yahrzeit_no_contact'}}</p>
                        </div>
                        {{/if}}

                        <div class="yahrzeit-actions yahrzeit-card-actions">
                            <a href="{{this.boardCardUrl}}" class="btn-admin btn-admin-ghost btn-admin-with-icon" target="_blank" rel="noopener noreferrer">
                                <svg class="btn-admin-inline-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/></svg>
                                {{t 'yahrzeit_view_board'}}
                            </a>
                            <a href="/admin/{{../synagogue.slug}}/people?edit={{this.id}}" class="btn-admin btn-admin-secondary btn-admin-with-icon">
                                <svg class="btn-admin-inline-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1.003 1.003 0 0 0 0-1.42l-2.34-2.34a1.003 1.003 0 0 0-1.42 0l-1.83 1.83 3.75 3.75 1.84-1.82z"/></svg>
                                {{t 'edit'}}
                            </a>
                        </div>
                    </div>
            </div>
        </article>
        {{/each}}
    </div>
    {{else}}
    <div class="admin-empty-state">
        <p>{{t 'yahrzeit_empty'}}</p>
    </div>
    {{/if}}

    {{#if weekEntries.length}}
