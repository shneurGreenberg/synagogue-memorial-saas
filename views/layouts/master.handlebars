<!DOCTYPE html>
<html lang="he" dir="rtl">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{t 'master_title'}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Heebo:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    {{#if showMasterMap}}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
    {{/if}}
    <link rel="stylesheet" href="/css/master.css?v={{@root.cssVersion}}">
</head>

<body class="master-body master-rtl">
    {{> beh-badge}}
    {{#if showMasterLogout}}
    <a href="/master/logout" class="master-side-logout" title="{{t 'logout'}}" aria-label="{{t 'logout'}}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16 17v-3H9v-4h7V7l5 5-5 5M14 2a2 2 0 0 1 2 2v2h-2V4H5v16h9v-2h2v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9Z"/></svg>
    </a>
    {{/if}}
    <main class="master-main">
        {{{body}}}
    </main>
    {{#if showMasterMap}}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    {{/if}}
    {{#if showMasterMap}}
    <script src="/js/community-web-address.js"></script>
    <script src="/js/master-dashboard.js"></script>
    {{/if}}
    {{#if showMasterWizard}}
    <script type="application/json" id="masterWizardLabels">{{{wizardLabelsJson}}}</script>
    <script src="/js/master-wizard.js"></script>
    {{/if}}
    {{#if showMasterLogout}}
    <script src="/js/master-onboarding-copy.js"></script>
    {{/if}}
</body>

</html>
