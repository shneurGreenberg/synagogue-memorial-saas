<!DOCTYPE html>
<html lang="{{lang}}" dir="{{#if (eq lang 'he')}}rtl{{else}}ltr{{/if}}">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{onboardingT 'page_title'}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Heebo:wght@400;500;600;700&display=swap" rel="stylesheet">
    {{#if showOnboardingMap}}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
    {{/if}}
    <link rel="stylesheet" href="/css/master.css">
    <link rel="stylesheet" href="/css/onboarding.css">
</head>

<body class="onboarding-body{{#if (eq lang 'he')}} onboarding-rtl{{/if}}">
    <header class="onboarding-topbar">
        <img class="onboarding-brand-logo" src="{{officialLogoUrl}}" alt="">
        <div class="onboarding-lang-switcher">
            <label class="onboarding-lang-label" for="onboardingLangSelect">{{onboardingT 'language_label'}}</label>
            <select id="onboardingLangSelect" class="onboarding-lang-select" aria-label="{{onboardingT 'language_label'}}">
                <option value="he" {{#if (eq lang 'he')}}selected{{/if}}>{{onboardingT 'lang_he'}}</option>
                <option value="ru" {{#if (eq lang 'ru')}}selected{{/if}}>{{onboardingT 'lang_ru'}}</option>
                <option value="en" {{#if (eq lang 'en')}}selected{{/if}}>{{onboardingT 'lang_en'}}</option>
            </select>
        </div>
    </header>
    <main class="onboarding-main">
        {{{body}}}
    </main>
    {{#if showOnboardingMap}}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    {{/if}}
    <script src="/js/onboarding-lang.js"></script>
    {{#if showOnboardingWizard}}
    <script type="application/json" id="onboardingConfig">{{{onboardingConfigJson}}}</script>
    <script src="/js/onboarding-wizard.js"></script>
    {{/if}}
</body>

</html>
