<!DOCTYPE html>
<html lang="{{#if synagogue.adminLanguage}}{{synagogue.adminLanguage}}{{else}}ru{{/if}}" dir="{{#if adminDir}}{{adminDir}}{{else}}ltr{{/if}}">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin Dashboard</title>
    <link rel="icon" href="{{#if yahrzeitTodayCount}}{{faviconAlertUrl}}{{else}}{{faviconUrl}}{{/if}}" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/admin.css?v={{@root.cssVersion}}">
    <meta name="color-scheme" content="light dark">
    <link rel="manifest" href="/admin-manifest.webmanifest">
    <meta name="theme-color" content="#1f1f24">
    <link rel="apple-touch-icon" href="/images/admin-pwa-icon-192.png">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
</head>

<body data-admin-nav="{{adminNavActive}}" data-slug="{{synagogue.slug}}" class="admin-body admin-page-{{adminNavActive}} admin-theme-{{#if synagogue.adminColorMode}}{{synagogue.adminColorMode}}{{else}}dark{{/if}}{{#if adminIsRtl}} admin-rtl{{/if}}">
    {{#if impersonatedByMaster}}
    <div class="admin-master-impersonation-banner" role="status">
        <span>{{t 'master_impersonation_banner'}}</span>
        <form method="POST" action="/admin/{{synagogue.slug}}/end-master-impersonation" class="admin-master-impersonation-form">
            <button type="submit" class="btn-admin btn-admin-secondary btn-admin-sm">{{t 'master_impersonation_return'}}</button>
        </form>
    </div>
    {{/if}}
    <nav class="navbar navbar-expand-lg navbar-dark admin-navbar">
        <div class="admin-navbar-beh" aria-hidden="true">ב״ה</div>
        <a class="navbar-brand admin-navbar-brand" href="/admin/{{synagogue.slug}}/dashboard" data-mobile-href="/admin/{{synagogue.slug}}/home">
            <img class="admin-brand-logo" src="{{officialLogoUrl}}" alt="">
            <span class="admin-synagogue-badge">{{synagogue.communityDisplayName}}</span>
        </a>
        <button class="navbar-toggler admin-navbar-toggler" type="button"
            aria-controls="adminNavbar" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div id="adminNavBackdrop" class="admin-nav-backdrop" aria-hidden="true"></div>
        <div class="collapse navbar-collapse admin-nav-drawer" id="adminNavbar">
            <ul class="navbar-nav admin-nav-links mr-auto">
                {{#if adminPermissions.settings}}
                <li class="nav-item">
                    <a class="nav-link{{#if (eq adminNavActive 'settings')}} active{{/if}}" href="/admin/{{synagogue.slug}}/dashboard">
                        <svg class="admin-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 15.5A3.5 3.5 0 0 1 8.5 12 3.5 3.5 0 0 1 12 8.5a3.5 3.5 0 0 1 3.5 3.5 3.5 3.5 0 0 1-3.5 3.5m7.43-2.53c.04-.32.07-.64.07-.97 0-.33-.03-.66-.07-1l2.11-1.63c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.31-.61-.22l-2.49 1c-.52-.39-1.06-.73-1.69-.98l-.37-2.65A.506.506 0 0 0 14 2h-4c-.25 0-.46.18-.5.42l-.37 2.65c-.63.25-1.17.59-1.69.98l-2.49-1c-.22-.09-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64L4.57 11c-.04.34-.07.67-.07 1 0 .33.03.65.07.97l-2.11 1.66c-.19.15-.25.42-.12.64l2 3.46c.12.22.39.3.61.22l2.49-1.01c.52.4 1.06.74 1.69.99l.37 2.65c.04.24.25.42.5.42h4c.25 0 .46-.18.5-.42l.37-2.65c.63-.26 1.17-.59 1.69-.99l2.49 1.01c.22.08.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.66Z"/></svg>
                        {{t 'board_settings'}}
                    </a>
                </li>
                {{/if}}
                {{#if adminPermissions.people}}
                <li class="nav-item">
                    <a class="nav-link{{#if (eq adminNavActive 'yahrzeit')}} active{{/if}}{{#if yahrzeitTodayCount}} nav-link-yahrzeit-alert{{/if}}" href="/admin/{{synagogue.slug}}/yahrzeit">
                        <svg class="admin-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2c-1.1 0-2 .9-2 2v1.07C7.06 5.56 5 7.92 5 11v5l-2 2v1h18v-1l-2-2v-5c0-3.08-2.06-5.44-5-5.93V4c0-1.1-.9-2-2-2m0 2c.55 0 1 .45 1 1v1h-2V5c0-.55.45-1 1-1m-1 9h2v3h-2v-3Z"/></svg>
                        {{t 'yahrzeit_page'}}{{#if yahrzeitTodayCount}} <span class="nav-yahrzeit-badge">{{yahrzeitTodayCount}}</span>{{/if}}
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link{{#if (or (eq adminNavActive 'people') (eq adminNavActive 'contact-directory'))}} active{{/if}}" href="/admin/{{synagogue.slug}}/people">
                        <svg class="admin-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                        {{t 'people'}}
                    </a>
                </li>
                {{/if}}
                {{#if adminPermissions.events}}
                <li class="nav-item">
                    <a class="nav-link{{#if (eq adminNavActive 'events')}} active{{/if}}" href="/admin/{{synagogue.slug}}/events">
                        {{{adminIcon 'announcement' 'admin-nav-icon'}}}
                        {{t 'board_content'}}
                    </a>
                </li>
                {{/if}}
                <li class="nav-item">
                    <a class="nav-link{{#if (eq adminNavActive 'users')}} active{{/if}}" href="/admin/{{synagogue.slug}}/users">
                        <svg class="admin-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3m-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3m0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5m8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5Z"/></svg>
                        {{#if canManageUsers}}{{t 'user_management'}}{{else}}{{t 'my_admin_preferences'}}{{/if}}
                    </a>
                </li>
            </ul>
            <div class="admin-navbar-actions">
                {{#if adminUser}}
                <span class="admin-user-badge">{{#if adminUser.displayName}}{{adminUser.displayName}}{{else}}{{adminUser.username}}{{/if}}</span>
                {{/if}}
                <a class="btn btn-outline-light btn-admin-nav-board" href="/s/{{synagogue.slug}}" target="_blank" rel="noopener">
                    <svg class="admin-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21 3H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h5v2h8v-2h5c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2m0 14H3V5h18v12Z"/></svg>
                    {{t 'view_board'}}
                </a>
                <a class="btn btn-outline-light" href="/admin/logout">
                    <svg class="admin-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5-5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/></svg>
                    {{t 'logout'}}
                </a>
            </div>
        </div>
    </nav>
    {{#unless (eq adminNavActive 'home')}}
    <div class="admin-mobile-backbar">
        <a class="admin-mobile-back" href="/admin/{{synagogue.slug}}/home">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="admin-mobile-back-icon"><path fill="currentColor" d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2Z"/></svg>
            <span>{{t 'back_to_main'}}</span>
        </a>
    </div>
    {{/unless}}
    <div id="adminBusyOverlay" class="admin-busy-overlay" hidden aria-hidden="true">
        <div class="admin-busy-card">
            <div class="admin-busy-spinner" role="status"></div>
            <span id="adminBusyText">{{t 'saving'}}</span>
        </div>
    </div>
    <div class="admin-container">
        {{{body}}}
    </div>
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/admin-icons.js?v={{@root.cssVersion}}"></script>
    <script src="/js/admin-nav.js?v={{@root.cssVersion}}"></script>
    <script src="/js/admin-locale.js?v={{@root.cssVersion}}"></script>
    <script src="/js/admin-form-feedback.js?v={{@root.cssVersion}}"></script>
    <script src="/js/admin-save-toast.js?v={{@root.cssVersion}}"></script>
    <script src="/js/admin-mobile-save.js?v={{@root.cssVersion}}"></script>
    <script src="/js/admin-color-picker.js?v={{@root.cssVersion}}"></script>
    <script>
    if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
            navigator.serviceWorker.register('/admin-sw.js', { scope: '/admin/' }).catch(function () {});
        });
    }
    </script>
    {{#each adminPageScripts}}
    <script src="/js/{{this}}?v={{@root.cssVersion}}"></script>
    {{/each}}
</body>

</html>
