<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#1a140f">
    <meta name="robots" content="noindex">
    <title>Надгробие — {{synagogue.name}}</title>
    <style>
        :root {
            color-scheme: dark;
            --bg: #1a140f;
            --card: rgba(28, 22, 16, 0.92);
            --line: rgba(255, 236, 200, 0.18);
            --text: #f6f1e7;
            --muted: #d9cbb6;
            --gold: #e6c35c;
            --gold-deep: #8d6a16;
            --danger: #ffb4a8;
            --ok: #b7e4c7;
        }

        * { box-sizing: border-box; }

        [hidden] { display: none !important; }

        html, body {
            margin: 0;
            min-height: 100%;
        }

        body {
            font-family: "Segoe UI", system-ui, sans-serif;
            background:
                linear-gradient(180deg, rgba(20, 14, 10, 0.72), rgba(20, 14, 10, 0.88)),
                url('/images/brickwall.jpg') center / cover fixed;
            color: var(--text);
            padding: calc(16px + env(safe-area-inset-top)) 16px calc(24px + env(safe-area-inset-bottom));
        }

        .scan-shell {
            width: min(100%, 520px);
            margin: 0 auto;
        }

        .scan-card {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 22px;
            padding: 20px 16px 16px;
            box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
        }

        .scan-kicker {
            margin: 0;
            text-align: center;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: var(--gold);
            font-size: 13px;
        }

        h1 {
            margin: 6px 0 8px;
            text-align: center;
            font-size: clamp(28px, 8vw, 36px);
            line-height: 1.15;
        }

        .scan-lead, .scan-note {
            margin: 0 0 16px;
            text-align: center;
            color: var(--muted);
            font-size: 17px;
            line-height: 1.4;
        }

        .scan-actions, .scan-form, .scan-loading, .scan-done {
            display: grid;
            gap: 12px;
        }

        .scan-primary, .scan-secondary, .scan-submit, .scan-text-button, .scan-link {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 64px;
            border-radius: 16px;
            font-size: 20px;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            border: 0;
            width: 100%;
            overflow: hidden;
        }

        .scan-primary, .scan-submit {
            background: linear-gradient(180deg, #f0d78a, var(--gold) 40%, #c8962e);
            color: #2a1d08;
        }

        .scan-secondary, .scan-text-button, .scan-link {
            background: transparent;
            color: var(--text);
            border: 2px solid var(--line);
        }

        .scan-file {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            cursor: pointer;
            font-size: 16px;
        }

        .scan-preview {
            display: block;
            width: 100%;
            max-height: 38vh;
            object-fit: contain;
            border-radius: 16px;
            background: #000;
            margin-bottom: 14px;
        }

        .scan-loading {
            min-height: 120px;
            place-items: center;
            text-align: center;
            font-size: 20px;
        }

        .scan-spinner {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            border: 4px solid rgba(230, 195, 92, 0.25);
            border-top-color: var(--gold);
            animation: scan-spin 0.8s linear infinite;
        }

        @keyframes scan-spin { to { transform: rotate(360deg); } }

        .scan-alert {
            margin: 0;
            padding: 12px 14px;
            border-radius: 14px;
            background: rgba(120, 32, 18, 0.45);
            color: var(--danger);
            font-size: 16px;
        }

        .scan-alert.is-ok {
            background: rgba(20, 70, 40, 0.45);
            color: var(--ok);
        }

        label {
            display: grid;
            gap: 6px;
            font-size: 15px;
            color: var(--muted);
        }

        input, textarea {
            width: 100%;
            border: 1px solid var(--line);
            border-radius: 12px;
            background: rgba(0, 0, 0, 0.28);
            color: var(--text);
            font: inherit;
            font-size: 18px;
            padding: 12px 14px;
            min-height: 52px;
        }

        textarea { min-height: 110px; resize: vertical; }

        .scan-date {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }

        .scan-matches {
            display: grid;
            gap: 8px;
            padding: 12px;
            border-radius: 14px;
            border: 1px solid var(--line);
        }

        .scan-matches p { margin: 0; }

        .scan-match {
            display: flex;
            gap: 10px;
            align-items: center;
            min-height: 44px;
            font-size: 16px;
            color: var(--text);
        }

        .scan-confidence, .scan-foot {
            margin: 0;
            text-align: center;
            color: var(--muted);
            font-size: 14px;
        }

        details {
            color: var(--muted);
            font-size: 15px;
        }

        details pre {
            white-space: pre-wrap;
            font: inherit;
            margin: 8px 0 0;
        }

        .scan-done h2 {
            margin: 0;
            text-align: center;
            font-size: 28px;
        }

        .scan-done p { text-align: center; font-size: 18px; }

        button:disabled { opacity: 0.6; }
    </style>
</head>

<body>
    <div class="scan-shell">
        <div class="scan-card">
            {{{body}}}
        </div>
    </div>
    <script src="/js/scan-grave.js"></script>
</body>

</html>
